//...recursion
class Solution {
    int transform(int i, int j, String s1, String s2) {

        if (i < 0) {
            return j + 1;   
        }

        if (j < 0) {
            return i + 1;  
        }

        if (s1.charAt(i) == s2.charAt(j)) {
            return transform(i - 1, j - 1, s1, s2);
        }

        int delete = 1 + transform(i - 1, j, s1, s2);
        int insert = 1 + transform(i, j - 1, s1, s2);

        return Math.min(delete, insert);
    }

    public int minOperations(String s1, String s2) {
        return transform(s1.length() - 1, s2.length() - 1, s1, s2);
    }
}

//...memoization
class Solution {
    int transform(int i, int j, String s1, String s2, int[][] dp) {

        if (i < 0) {
            return j + 1;
        }

        if (j < 0) {
            return i + 1;
        }

        if (dp[i][j] != -1) {
            return dp[i][j];
        }

        if (s1.charAt(i) == s2.charAt(j)) {
            return dp[i][j] = transform(i - 1, j - 1, s1, s2, dp);
        }

        int delete = 1 + transform(i - 1, j, s1, s2, dp);
        int insert = 1 + transform(i, j - 1, s1, s2, dp);

        return dp[i][j] = Math.min(delete, insert);
    }

    public int minOperations(String s1, String s2) {
        int n = s1.length();
        int m = s2.length();

        int[][] dp = new int[n][m];

        for (int i = 0; i < n; i++) {
            Arrays.fill(dp[i], -1);
        }

        return transform(n - 1, m - 1, s1, s2, dp);
    }
}

//...tabulation

class Solution {
    public int minOperations(String s1, String s2) {

        int n = s1.length();
        int m = s2.length();

        int[][] dp = new int[n + 1][m + 1];

        // s2 is empty → delete all characters of s1
        for (int i = 0; i <= n; i++) {
            dp[i][0] = i;
        }

        // s1 is empty → insert all characters of s2
        for (int j = 0; j <= m; j++) {
            dp[0][j] = j;
        }

        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= m; j++) {

                if (s1.charAt(i - 1) == s2.charAt(j - 1)) {
                    dp[i][j] = dp[i - 1][j - 1];
                }
                else {
                    int delete = 1 + dp[i - 1][j];
                    int insert = 1 + dp[i][j - 1];

                    dp[i][j] = Math.min(delete, insert);
                }
            }
        }

        return dp[n][m];
    }
}
