//recursion
class Solution {
    int insertion(int i, int j, String s) {
        if (i >= j) {
            return 0;
        }

        if (s.charAt(i) == s.charAt(j)) {
            return insertion(i + 1, j - 1, s);
        }

        int s1 = 1 + insertion(i + 1, j, s);
        int s2 = 1 + insertion(i, j - 1, s);

        return Math.min(s1, s2);
    }

    public int minInsertions(String s) {
        return insertion(0, s.length() - 1, s);
    }
}

//memoization
class Solution {
    int insertion(int i, int j, String s, int[][] dp) {
        if (i >= j) {
            return 0;
        }

        if (dp[i][j] != -1) {
            return dp[i][j];
        }

        if (s.charAt(i) == s.charAt(j)) {
            return dp[i][j] = insertion(i + 1, j - 1, s, dp);
        }

        int s1 = 1 + insertion(i + 1, j, s, dp);
        int s2 = 1 + insertion(i, j - 1, s, dp);

        return dp[i][j] = Math.min(s1, s2);
    }

    public int minInsertions(String s) {
        int n = s.length();

        int[][] dp = new int[n][n];

        for (int i = 0; i < n; i++) {
            Arrays.fill(dp[i], -1);
        }

        return insertion(0, n - 1, s, dp);
    }
}

//tabulation

class Solution {
    public int minInsertions(String s) {
        int n = s.length();

        int[][] dp = new int[n][n];

        for (int i = n - 2; i >= 0; i--) {
            for (int j = i + 1; j < n; j++) {

                if (s.charAt(i) == s.charAt(j)) {
                    dp[i][j] = dp[i + 1][j - 1];
                } else {
                    dp[i][j] = 1 + Math.min(dp[i + 1][j],dp[i][j - 1]);
                }
            }
        }

        return dp[0][n - 1];
    }
}
