class Solution {
    public ArrayList<Integer> calculateSpan(int[] arr) {
        ArrayList<Integer> li = new ArrayList<>();
        Stack<Integer> st = new Stack<>();
        int n = arr.length;

        for(int i = 0; i < n; i++){
            while(!st.isEmpty() && arr[st.peek()] <= arr[i]){
                st.pop();
            }
            int span = st.isEmpty() ? (i + 1) : (i - st.peek());
            li.add(span);
            st.push(i);
        }

        return li;
    }
}
