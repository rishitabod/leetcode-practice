class Solution {
    ArrayList<Integer> findTwoElement(int arr[]) {

        Arrays.sort(arr);

        int repeating = -1;
        int missing = -1;
        for(int i = 1; i < arr.length; i++) {
            if(arr[i] == arr[i-1]) {
                repeating = arr[i];
                break;
            }
        }
        int expected = 1;

        for(int i = 0; i < arr.length; i++) {
            if(arr[i] == expected) {
                expected++;
            }
            else if(arr[i] > expected) {
                missing = expected;
                break;
            }
        }
        if(missing == -1) {
            missing = arr.length;
        }

        ArrayList<Integer> ans = new ArrayList<>();
        ans.add(repeating);
        ans.add(missing);

        return ans;
    }
}
