public class Solution {
    public ListNode detectCycle(ListNode head) {
        HashSet<ListNode> cycle = new HashSet<>();
        ListNode temp = head;
        if(head == null || head.next == null){
            return null;
        }
        while(temp != null){
            if(cycle.contains(temp)) return temp;
            cycle.add(temp);
            temp = temp.next;
        }
        return null;
    }
}
// optimal
public class Solution {
    public ListNode detectCycle(ListNode head) {
        if(head == null || head.next == null){
            return null;
        }
        ListNode slow = head;
        ListNode fast = head;
        while(fast != null && fast.next!=null){
            slow = slow.next;
            fast = fast.next.next;
            if(slow == fast ){
                slow = head;
                while(slow != fast){
                    slow = slow.next;
                    fast = fast.next;
                }return slow;
            }
        }    
        return null;
    }
}
