class Solution {
    public ArrayList<ArrayList<Integer>> givenSumPairs(Node head, int target) {
        ArrayList<ArrayList<Integer>> ans = new ArrayList<>();

        if(head == null){
            return ans;
        }

        Node first = head;
        Node last = head;
        while(last.next != null){
            last = last.next;
        }

        while(first != last && last.next != first){
            int sum = first.data + last.data;

            if(sum == target){
                ans.add(new ArrayList<>(Arrays.asList(first.data, last.data)));
                first = first.next;
                last = last.prev;
            } else if(sum < target){
                first = first.next;
            } else {
                last = last.prev;
            }
        }

        return ans;
    }
}
