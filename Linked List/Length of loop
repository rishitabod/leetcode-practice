class Solution {
    public int lengthOfLoop(Node head) {
        HashMap<Node, Integer> loop = new HashMap<>();
        int timer = 1;
        Node temp = head;

        while(temp != null){
            if(loop.containsKey(temp)){
                return timer - loop.get(temp);
            }
            loop.put(temp, timer);
            timer++;
            temp = temp.next;
        }
        return 0;
    }
}
