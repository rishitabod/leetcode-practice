class Solution {
    public ListNode deleteMiddle(ListNode head) {
        ListNode temp = head;
        ListNode slow = head;
        ListNode fast = head;
        ListNode middle = head;
        if(head == null || head.next == null){
            return null;
        }

        while(fast != null && fast.next!=null){
            slow = slow.next;
            fast = fast.next.next;
            
        }
        middle = slow;

        while(temp.next != middle){
            temp = temp.next;
        }
        temp.next = middle.next;
        return head;
    }
}
