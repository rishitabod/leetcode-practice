class Solution {
    public boolean detectLoop(Node head) {
        HashSet<Node> visited = new HashSet<>();
        Node temp = head;
        while(temp != null){
            if(visited.contains(temp)){
                return true;
            }
            visited.add(temp);
            temp = temp.next;
        }
        return false;
    }
}
//Optimal
class Solution {
    public boolean detectLoop(Node head) {
        Node slow = head;
        Node fast = head;
        while(fast != null && fast.next != null){
            slow = slow.next;
            fast = fast.next.next;
            if(slow == fast) return true;
        }
        return false;
    }
}
